# ============================================================
# LLM Provider API Keys
# ============================================================
# Google Gemini API Key (used for Router, Code Generation, and Medium-tier tasks)

GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API Key (used for low-latency curation & synthesis)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (used for high-tier routing fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
# PostgreSQL Database Connection
# ============================================================
host=localhost
port=5432
database= your_postgres_database_name
user=your_postgres_usesuser_name
password=your_postgres_password_here
